rules_version = '2';

// Physio-Aid Firestore rules.
//
// Assessments live at users/{uid}/assessments/{assessmentId} and every saved
// document carries a userId field (written by saveAssessment in
// src/lib/assessment-history.ts). Users can only touch their own records,
// and writes must stamp their own uid into userId. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/assessments/{assessmentId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.userId == request.auth.uid;
    }

    // User-owned profile (users/{uid}/profile/main) — written by onboarding.
    match /users/{uid}/profile/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
